<div class="container py-5">
  <div class="row min-vh-50 align-items-center justify-content-center">
    <div class="col-md-6 text-center">
      <div class="card shadow-sm border-0 py-5">
        <div class="card-body">
          <i class="fas fa-exclamation-triangle fa-5x text-warning mb-4"></i>
          <h2 class="mb-3">Oops! Algo salió mal.</h2>
          
          <p class="text-muted mb-4 fs-5">
            {{#if mensaje}}
              {{mensaje}}
            {{else}}
              Ha ocurrido un error inesperado al procesar tu solicitud.
            {{/if}}
          </p>

          <a href="/" class="btn btn-violeta-azulado btn-lg">
            <i class="fas fa-home me-2"></i> Volver al Inicio
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
