<!-- Header -->
<div class="header d-flex justify-content-between align-items-center">
    <h4 class="mb-0">Dashboard</h4>
</div>

<!-- Metrics Cards -->
<div class="row mb-3">
    <div class="col-md-4 col-6">
        <div class="card metric-card">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="metric-value">${{metricas.ingresos}}</div>
                        <div class="metric-title">Ingresos Totales</div>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-currency-dollar" style="font-size: 24px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-6">
        <div class="card metric-card">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="metric-value">{{metricas.usuarios}}</div>
                        <div class="metric-title">Usuarios Registrados</div>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-people" style="font-size: 24px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-12 mt-md-0 mt-2">
        <div class="card metric-card">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="metric-value">{{metricas.pedidos}}</div>
                        <div class="metric-title">Pedidos</div>
                    </div>
                    <div class="align-self-center">
                        <i class="bi bi-cart" style="font-size: 24px;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts and Tables -->
<div class="row mb-3">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header">
                Productos Populares
            </div>
            <div class="card-body p-0">
                <div class="table-container">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Ventas</th>
                                <th>Inventario</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each productosTabla}}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {{#if this.imagen}}
                                        <img src="/uploads/{{this.imagen}}" alt="{{this.nombre}}" style="width: 40px; height: 40px; border-radius: 4px; object-fit: cover;" class="me-2">
                                        {{else}}
                                        <div class="bg-light rounded p-2 me-2"><i class="bi bi-box"></i></div>
                                        {{/if}}
                                        <div>
                                            <h6 class="mb-0">{{this.nombre}}</h6>
                                            <small class="text-muted">ID: {{this.id_producto}}</small>
                                        </div>
                                    </div>
                                </td>
                                <td>${{this.precio}}</td>
                                <td><!-- Se requeriría join con pedidoItems para ventas reales --> - </td>
                                <td>{{this.stockTotal}}</td>
                                <td>
                                    {{#if (gt this.stockTotal 0)}}
                                        <span class="badge bg-success">En Stock</span>
                                    {{else}}
                                        <span class="badge bg-danger">Agotado</span>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}
                            {{^productosTabla}}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No hay productos registrados</td>
                            </tr>
                            {{/productosTabla}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 mt-lg-0 mt-3">
        <div class="card h-100">
            <div class="card-header">
                Actividad Reciente
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    {{#each pedidosRecientes}}
                    <li class="list-group-item px-3 py-3">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1 text-violeta-azulado">Pedido #{{this.id_pedido}}</h6>
                            <small class="text-muted">{{formatearFecha this.fecha}}</small>
                        </div>
                        <p class="mb-1 fw-bold">${{this.total}} <span class="badge bg-light text-dark fw-normal ms-2">{{this.estado}}</span></p>
                        <small class="text-muted"><i class="bi bi-person me-1"></i> {{this.cliente.relacion_cliente_usuario.nombre}} {{this.cliente.relacion_cliente_usuario.apellido}}</small>
                    </li>
                    {{/each}}
                    {{^pedidosRecientes}}
                    <li class="list-group-item text-center text-muted py-4">No hay actividad reciente</li>
                    {{/pedidosRecientes}}
                </ul>
            </div>
        </div>
    </div>
</div>